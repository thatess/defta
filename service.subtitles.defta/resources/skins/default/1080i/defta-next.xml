<?xml version="1.0" encoding="UTF-8"?>
<!-- Sıradaki bölüm sorusu: sağ üstte küçük kutu, video oynamaya devam eder.
     Alttaki çubuk 15 saniyede boşalır; boşalınca çevrilir. Geri tuşu = İptal. -->
<window>
  <defaultcontrol always="true">3001</defaultcontrol>
  <zorder>2</zorder>
  <coordinates>
    <left>1320</left>
    <top>40</top>
  </coordinates>
  <animation type="WindowOpen" reversible="false">
    <effect type="slide" start="80,0" end="0,0" time="250" tween="cubic" easing="out"/>
    <effect type="fade" start="0" end="100" time="250"/>
  </animation>
  <animation type="WindowClose" reversible="false">
    <effect type="fade" start="100" end="0" time="200"/>
  </animation>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>560</width>
      <height>168</height>
      <texture colordiffuse="E6101418">defta-white.png</texture>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>6</width>
      <height>168</height>
      <texture colordiffuse="FFF2B705">defta-white.png</texture>
    </control>
    <control type="label" id="3010">
      <left>26</left>
      <top>14</top>
      <width>514</width>
      <height>36</height>
      <font>font13</font>
